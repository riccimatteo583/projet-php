{
  "name": "riccimatteo583/projet-php",
  "description": "An advanced PHP MVC REST API skeleton with routing, dependency container, PDO models and PSR-4 autoloading.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
